<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Search Bar Section (standalone, no Toolbar chrome) -->
    <LinearLayout
        android:id="@+id/searchBarSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Search items..."
            android:paddingStart="44dp"
            android:paddingEnd="16dp"
            android:background="@drawable/search_background"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

    </LinearLayout>

    <!-- Static Section: Recent Searches + Popular Categories (shown when not searching) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/staticSearchSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_light"
        app:layout_constraintTop_toBottomOf="@id/searchBarSection"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Recent Searches Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_marginTop="8dp">

                <!-- Header row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/recentSearchesTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Searches"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/clearAllText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear all"
                        android:textSize="13sp"
                        android:textColor="@color/phinma_dark_green"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Dynamic recent search rows (populated in code) -->
                <LinearLayout
                    android:id="@+id/recentSearchesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp" />

                <!-- No recent searches placeholder -->
                <TextView
                    android:id="@+id/noRecentSearchesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No recent searches"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:visibility="visible" />

            </LinearLayout>

            <!-- Popular Categories Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_marginTop="8dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Popular Categories"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categoryChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="6dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipElectronics"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Electronics"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipClothing"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clothing"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBooks"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Books"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipIdCard"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID Card"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPhone"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBag"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bag"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipKeys"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keys"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWallet"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wallet"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUmbrella"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Umbrella"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWaterBottle"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Water Bottle"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/light_gray" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Search Progress -->
    <ProgressBar
        android:id="@+id/searchProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchBarSection"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Type Filter Chips (shown when results are visible) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/typeFilterChipGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@color/white"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/searchBarSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterAll"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:checked="true"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterLost"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lost"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterFound"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Found"
            android:textSize="13sp" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Search Results -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchResultsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/typeFilterChipGroup"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- No Search Results Empty State -->
    <LinearLayout
        android:id="@+id/emptySearchResultsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/typeFilterChipGroup"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_search"
            android:tint="#BDBDBD"
            android:contentDescription="No results" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:id="@+id/emptySearchTitle"
            android:text="No results found"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Try different keywords or a category"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:menu="@menu/bottom_navigation_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GCash-style Scan FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/scanFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_scan"
        android:contentDescription="Scan"
        app:backgroundTint="@color/phinma_dark_green"
        app:tint="@color/white"
        app:fabSize="normal"
        app:elevation="8dp"
        android:elevation="16dp"
        android:stateListAnimator="@null"
        android:layout_marginBottom="-28dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
