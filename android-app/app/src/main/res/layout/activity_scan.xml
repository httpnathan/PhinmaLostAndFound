<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera preview background -->
    <View
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#1A1A1A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Dark overlay top -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/scannerFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Dark overlay bottom -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC000000"
        app:layout_constraintTop_toBottomOf="@id/scannerFrame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Dark overlay left -->
    <View
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:background="#CC000000"
        app:layout_constraintTop_toTopOf="@id/scannerFrame"
        app:layout_constraintBottom_toBottomOf="@id/scannerFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/scannerFrame"/>

    <!-- Dark overlay right -->
    <View
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:background="#CC000000"
        app:layout_constraintTop_toTopOf="@id/scannerFrame"
        app:layout_constraintBottom_toBottomOf="@id/scannerFrame"
        app:layout_constraintStart_toEndOf="@id/scannerFrame"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Scanner viewfinder box -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scannerFrame"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <!-- Corner TL -->
        <View
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:background="@color/phinma_dark_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:layout_width="5dp"
            android:layout_height="36dp"
            android:background="@color/phinma_dark_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Corner TR -->
        <View
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:background="@color/phinma_dark_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:layout_width="5dp"
            android:layout_height="36dp"
            android:background="@color/phinma_dark_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Corner BL -->
        <View
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:background="@color/phinma_dark_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:layout_width="5dp"
            android:layout_height="36dp"
            android:background="@color/phinma_dark_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Corner BR -->
        <View
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:background="@color/phinma_dark_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:layout_width="5dp"
            android:layout_height="36dp"
            android:background="@color/phinma_dark_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Scan line -->
        <View
            android:id="@+id/scanLine"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/phinma_dark_green"
            android:alpha="0.9"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Instruction text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Point camera at a QR code"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/scannerFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Coming soon badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feature coming soon"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="#80000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/scannerFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-36dp"
        app:layout_constraintVertical_bias="0"
        android:visibility="gone"/>

    <!-- Top toolbar -->
    <LinearLayout
        android:id="@+id/scanToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/closeScanButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:padding="12dp"
            android:contentDescription="Close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan QR Code"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/flashToggleButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_flash"
            android:tint="@color/white"
            android:padding="8dp"
            android:contentDescription="Toggle Flash"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Gallery button at bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/chooseFromGalleryButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose from Gallery"
        android:textColor="@color/white"
        app:strokeColor="@color/white"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
