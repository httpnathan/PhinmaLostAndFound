<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Green Header -->
    <LinearLayout
        android:id="@+id/pageHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/phinma_dark_green"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Post Item"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Draft Banner -->
    <LinearLayout
        android:id="@+id/draftBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFF8E1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pageHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Draft restored"
            android:textColor="#F57F17"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/discardDraftButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discard"
            android:textColor="#F57F17"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="4dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/draftBanner"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Posting As Banner -->
            <TextView
                android:id="@+id/postingAsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Posting as: "
                android:textColor="@color/phinma_green"
                android:textStyle="bold"
                android:padding="12dp"
                android:background="#152E7D32"
                android:layout_marginBottom="16dp"/>

            <!-- Image Preview -->
            <ImageView
                android:id="@+id/postImageView"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerCrop"
                android:background="@drawable/image_placeholder_background"
                android:src="@drawable/ic_image_placeholder"
                android:contentDescription="Post image"/>

            <!-- Image Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/cameraButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Camera"
                    android:textColor="@color/phinma_dark_green"
                    android:backgroundTint="@color/white"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/phinma_dark_green"
                    android:layout_marginEnd="8dp"
                    style="?attr/materialButtonOutlinedStyle"/>

                <Button
                    android:id="@+id/selectImageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gallery"
                    android:textColor="@color/phinma_dark_green"
                    android:backgroundTint="@color/white"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/phinma_dark_green"
                    style="?attr/materialButtonOutlinedStyle"/>

            </LinearLayout>

            <!-- Post Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Post Type"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"/>

            <Spinner
                android:id="@+id/postTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/edittext_background"/>

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="16dp"/>

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/edittext_background"/>

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="16dp"/>

            <Spinner
                android:id="@+id/locationSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/edittext_background"/>

            <!-- Proof of Ownership Section (Security Question) -->
            <TextView
                android:id="@+id/securityQuestionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proof of Ownership (Security Question)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/securityQuestionEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. What is the lockscreen wallpaper?"
                android:padding="16dp"
                android:background="@drawable/edittext_background"
                android:inputType="textCapSentences"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Date Lost/Found -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date Lost/Found"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/dateLostFoundEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select date..."
                android:padding="16dp"
                android:background="@drawable/edittext_background"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_time"
                android:drawableTint="@color/phinma_dark_green"
                android:layout_marginTop="8dp"/>

            <!-- Item Name with char counter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Item Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/itemNameCharCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/80"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>

            </LinearLayout>

            <EditText
                android:id="@+id/itemNameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Blue backpack, Student ID, Keys..."
                android:padding="16dp"
                android:background="@drawable/edittext_background"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:layout_marginTop="8dp"/>

            <!-- Contact Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Number (Optional)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/contactNumberEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 0917-123-4567"
                android:padding="16dp"
                android:background="@drawable/edittext_background"
                android:inputType="phone"
                android:layout_marginTop="8dp"/>

            <!-- Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add Description"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/descriptionCharCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/500"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>

            </LinearLayout>

            <EditText
                android:id="@+id/descriptionEditText"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:hint="Write a description about the lost or found item..."
                android:gravity="top|start"
                android:padding="16dp"
                android:background="@drawable/edittext_background"
                android:inputType="textMultiLine"
                android:layout_marginTop="8dp"/>

            <!-- Preview + Post Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/previewButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Preview"
                    android:textColor="@color/phinma_dark_green"
                    android:backgroundTint="@color/white"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/phinma_dark_green"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp"
                    style="?attr/materialButtonOutlinedStyle"/>

                <Button
                    android:id="@+id/postButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Post"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/phinma_dark_green"
                    android:padding="16dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:menu="@menu/bottom_navigation_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- GCash-style Scan FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/scanFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_scan"
        android:contentDescription="Scan"
        app:backgroundTint="@color/phinma_dark_green"
        app:tint="@color/white"
        app:fabSize="normal"
        app:elevation="8dp"
        android:elevation="16dp"
        android:stateListAnimator="@null"
        android:layout_marginBottom="-28dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
