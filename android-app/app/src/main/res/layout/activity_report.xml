<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/reportTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Report Post"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/reportInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Why are you reporting this post?"
        app:layout_constraintTop_toBottomOf="@id/reportTitle"/>

    <RadioGroup
        android:id="@+id/reportReasonGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/reportInstructions">
        <RadioButton android:id="@+id/radioSpam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spam" />
        <RadioButton android:id="@+id/radioInappropriate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inappropriate Content" />
        <RadioButton android:id="@+id/radioScam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scam / Fraud" />
        <RadioButton android:id="@+id/radioOther" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" />
    </RadioGroup>

    <EditText
        android:id="@+id/otherReasonEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Please specify..."
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/reportReasonGroup"/>

    <Button
        android:id="@+id/submitReportButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Submit Report"
        android:backgroundTint="@color/phinma_dark_green"
        app:layout_constraintTop_toBottomOf="@id/otherReasonEditText"/>

</androidx.constraintlayout.widget.ConstraintLayout>
