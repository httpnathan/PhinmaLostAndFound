<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.phinmalostandfound"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />

    <permission
        android:name="com.example.phinmalostandfound.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.phinmalostandfound.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_logo"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.PhinmaLostAndFound"
        android:usesCleartextTraffic="true" >

        <!-- Main/Splash Activity -->
        <activity
            android:name="com.example.phinmalostandfound.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:name="com.example.phinmalostandfound.LoginActivity"
            android:exported="false" />
        <activity
            android:name="com.example.phinmalostandfound.SignUpActivity"
            android:exported="false" />

        <!-- Main App Activities -->
        <activity
            android:name="com.example.phinmalostandfound.HomeActivity"
            android:exported="false" />
        <activity
            android:name="com.example.phinmalostandfound.ProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.example.phinmalostandfound.SearchActivity"
            android:exported="false" />
        <activity
            android:name="com.example.phinmalostandfound.PostItemActivity"
            android:exported="false" />
        <activity
            android:name="com.example.phinmalostandfound.ChatSectionActivity"
            android:exported="false" />
        <activity
            android:name="com.example.phinmalostandfound.PrivateMessageActivity"
            android:exported="false" />

        <!-- Menu and Settings Activities -->
        <activity
            android:name="com.example.phinmalostandfound.MenuActivity"
            android:exported="false" />
        <activity
            android:name="com.example.phinmalostandfound.SettingsActivity"
            android:exported="false" />

        <!-- Additional Activities -->
        <activity
            android:name="com.example.phinmalostandfound.FAQsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.phinmalostandfound.AboutActivity"
            android:exported="false" />
        <activity
            android:name="com.example.phinmalostandfound.ReportActivity"
            android:exported="false" />

        <!-- Post Detail Activity -->
        <activity
            android:name="com.example.phinmalostandfound.PostDetailActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.phinmalostandfound.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>